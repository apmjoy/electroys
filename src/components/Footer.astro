---
import Wordmark from './Wordmark.astro';
import { AGE_BANDS, INTERESTS } from '../lib/taxonomy';
import { GIFT_GUIDES } from '../lib/gifts';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo"><img src="/logo.svg" alt="" width="40" height="40" /><Wordmark /></a>
        <p>Hand-picked STEM kits and brain-building gifts for curious kids, teens and young adults. Explore. Build. Learn. Play.</p>
      </div>
      <div>
        <h2 class="footer-h">Shop by age</h2>
        <ul>{AGE_BANDS.map((b) => <li><a href={`/shop/${b.slug}/`}>{b.label}</a></li>)}<li><a href="/shop/">All products</a></li></ul>
      </div>
      <div>
        <h2 class="footer-h">Interests</h2>
        <ul>{INTERESTS.slice(0, 6).map((i) => <li><a href={`/shop/${i.slug}/`}>{i.name}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="footer-h">Gift guides</h2>
        <ul>{GIFT_GUIDES.slice(0, 6).map((g) => <li><a href={`/gifts/${g.slug}/`}>{g.short}</a></li>)}</ul>
      </div>
      <div>
        <h2 class="footer-h">Electroys</h2>
        <ul>
          <li><a href="/about/">About us</a></li>
          <li><a href="/how-we-choose/">How we choose</a></li>
          <li><a href="/guides/">Buying guides</a></li>
          <li><a href="/contact/">Contact</a></li>
          <li><a href="/affiliate-disclosure/">Affiliate disclosure</a></li>
          <li><a href="/privacy/">Privacy</a></li>
          <li><a href="/terms/">Terms</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-legal">
      <p>As an Amazon Associate, Electroys earns from qualifying purchases. When you buy through links on our site we may earn a commission at no extra cost to you. Product availability and prices are set by the retailer and can change.</p>
      <p>© {year} Electroys</p>
    </div>
  </div>
</footer>
