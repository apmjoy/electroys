---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import CompareTray from '../components/CompareTray.astro';
import TabBar from '../components/TabBar.astro';
import IosInstallSheet from '../components/IosInstallSheet.astro';
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bodyFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import serifItalic from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
  bodyClass?: string;
}

const { title, description, image = '/og-default.png', noindex = false, jsonLd, bodyClass } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = title.includes('Electroys') ? title : `${title} | Electroys`;
const ogImage = image.startsWith('http') ? image : `${site}${image}`;
const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Electroys',
    url: `${site}/`,
    logo: `${site}/favicon-192.png`,
  },
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const GTAG_ID = 'GTM-5CJ7GCKB'; // Google tag container → GA4 property G-67H7VTBMWZ
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta name="theme-color" content="#fbf9f5" />
  <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={serifItalic} as="font" type="font/woff2" crossorigin />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Electroys" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={fullTitle} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="apple-mobile-web-app-title" content="Electroys" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="mobile-web-app-capable" content="yes" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Affiliate network site verification (kept from the original site) -->
  <meta name="impact-site-verification" content="5b4d6cd7-4124-44c5-b0d4-60bd351a9aa8" />
  <meta name="impact-site-verification" content="0fedb500-6338-4918-8425-0517efefd09e" />

  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

  <!-- Google Analytics (Google tag): production host only -->
  <script is:inline define:vars={{ GTAG_ID }}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    window.gtag = gtag;
    if (['electroys.com', 'www.electroys.com'].includes(location.hostname)) {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTAG_ID;
      document.head.appendChild(s);
      gtag('js', new Date());
    }
  </script>
</head>
<body class={bodyClass}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <SearchDialog />
  <CompareTray />
  <TabBar />
  <IosInstallSheet />
  <div class="toast" role="status" aria-live="polite" id="toast"></div>
  <script>
    import '../scripts/site.ts';
  </script>
</body>
</html>
